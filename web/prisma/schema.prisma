generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User.role: "STUDENT" | "PARENT" | "ADMIN"
// User.accountType: "STUDENT_SELF" | "PARENT" (meaningless for ADMIN)
model User {
  id                  String   @id @default(cuid())
  role                String   @default("STUDENT")
  accountType         String   @default("STUDENT_SELF")
  name                String
  phone               String?  @unique
  email               String?  @unique
  passwordHash        String
  studentName         String
  studentAge          Int?
  parentContact       String?
  consentPersonalData Boolean  @default(false)
  /// Анна отметила как своего ученика — для фильтра в админке.
  isPersonalStudent   Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  enrollments    Enrollment[]
  progress       LessonProgress[]
  passwordResets PasswordResetToken[]
  courseRequests PaidCourseRequest[]
  wordProgress   WordProgress[]
  wordAnswers    WordAnswer[]
}

model Course {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  shortDescription String
  description      String
  whatsIncluded    String?
  forWhom          String?
  duration         String?
  coverImage       String?
  isFree           Boolean  @default(false)
  priceRub         Int      @default(0)
  published        Boolean  @default(true)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  modules     Module[]
  enrollments Enrollment[]
  docs        CourseDoc[]
}

model Module {
  id       String @id @default(cuid())
  courseId String
  title    String
  order    Int    @default(0)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  title       String
  order       Int      @default(0)
  description String?
  /// Что сделать перед уроком: прочитать произведение, подготовить записи.
  prep        String?
  videoPath   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  materials Material[]
  progress  LessonProgress[]
  docs      CourseDoc[]
}

// Тексты курса, которые ученик читает прямо на сайте.
// CourseDoc.kind: "ROUTE" (маршрут и список чтения, без урока) | "NOTES" (конспект и задания)
//   | "ANSWERS" (ответы и самопроверка) | "MOCK" (темы пробника)
// body — упрощённый markdown: строки "# " — заголовки, остальные строки — абзацы.
model CourseDoc {
  id        String   @id @default(cuid())
  courseId  String
  lessonId  String?
  kind      String
  title     String
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// Заявка «Узнать о платном курсе» из финала бесплатного курса. Видна в админке.
// PaidCourseRequest.status: "NEW" | "DONE"
model PaidCourseRequest {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Material {
  id              String   @id @default(cuid())
  lessonId        String
  fileName        String
  filePath        String
  mimeType        String?
  sizeBytes       Int?
  downloadAllowed Boolean  @default(false)
  createdAt       DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// Enrollment.source: "FREE" | "ADMIN_GRANT" ("PAYMENT" — у старых записей, оплата на сайте убрана в октябре 2026)
model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  source    String   @default("FREE")
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Тренажёр словарных слов. Сами слова — в коде (src/content/words), здесь
// только прогресс ученика по id карточки ("d:акварель", "e:вплавь").
// WordProgress.deck: "dictionary" | "ege14"
// box: 0 — после ошибки, 1–5 — ступени повторения (через 1, 3, 7, 14, 30 дней).
// После верного ответа на 5-й ступени слово выучено (learnedAt).
model WordProgress {
  id             String    @id @default(cuid())
  userId         String
  cardId         String
  deck           String
  box            Int       @default(0)
  dueAt          DateTime
  correctCount   Int       @default(0)
  wrongCount     Int       @default(0)
  lastAnsweredAt DateTime
  learnedAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, deck, dueAt])
}

// Каждый засчитанный ответ (первый за день по слову) — для статистики
// и списка ошибок. given — что выбрал ученик, словом: «в плавь».
model WordAnswer {
  id        String   @id @default(cuid())
  userId    String
  cardId    String
  deck      String
  correct   Boolean
  given     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
